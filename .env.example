# Public site URL — used for canonical URLs, OG tags, sitemap, and robots.txt
# Update this to your custom domain when going live
NEXT_PUBLIC_SITE_URL=https://hiva-nine.vercel.app

# Contact form API endpoint (optional)
# If set, the contact form will POST JSON to this URL instead of opening mailto:
# NEXT_PUBLIC_CONTACT_API_URL=https://your-api-endpoint.com/contact

# Contact email — update once custom domain is live
# NEXT_PUBLIC_CONTACT_EMAIL=contact@hivevaultarc.com
