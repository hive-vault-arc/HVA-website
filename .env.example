# Public site URL - used for canonical URLs, OG tags, sitemap, and robots.txt
# Update this to your custom domain when going live
NEXT_PUBLIC_SITE_URL=https://hivevaultarc.com

# Sanity content API - used by the website to fetch Insights content
NEXT_PUBLIC_SANITY_PROJECT_ID=0zprc9fo
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Contact form API endpoint (optional)
# If set, the contact form will POST JSON to this URL instead of opening mailto:
# NEXT_PUBLIC_CONTACT_API_URL=https://your-api-endpoint.com/contact

# Contact email - update once custom domain is live
# NEXT_PUBLIC_CONTACT_EMAIL=contact@hivevaultarc.com

# IndexNow key - required only when submitting URLs with npm run indexnow
# Use 8-128 letters, numbers, underscores, or hyphens.
# The key is exposed at /indexnow-key.txt when configured.
# INDEXNOW_KEY=
# INDEXNOW_KEY_LOCATION=https://hivevaultarc.com/indexnow-key.txt

# Sanity webhook secret - required by /api/revalidate/sanity
# SANITY_REVALIDATE_SECRET=

# Server-only token with Viewer access, used to validate Studio preview URLs and read drafts.
# Never prefix this variable with NEXT_PUBLIC_.
# SANITY_PREVIEW_TOKEN=

# Microsoft Clarity is deliberately disabled until privacy controls, legal copy,
# and the production project settings have been reviewed.
# NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_ENABLE_MICROSOFT_CLARITY=false

# Google Analytics 4 is rendered only after analytics consent and only in a
# Vercel Production deployment. Do not configure this for Preview deployments.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
