{
  "name": "hva-website-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,mjs,md,json}\"",
    "assets:webp:dry-run": "node scripts/convert-local-raster-assets.mjs",
    "assets:webp": "node scripts/convert-local-raster-assets.mjs --apply",
    "cms:webp:dry-run": "sanity exec scripts/migrate-cms-images-to-webp.mjs --with-user-token",
    "cms:webp": "sanity exec scripts/migrate-cms-images-to-webp.mjs --with-user-token -- --apply",
    "import:capabilities": "sanity exec scripts/import-capabilities.mjs --with-user-token",
    "import:employee-profiles": "sanity exec scripts/import-employee-profiles.mjs --with-user-token",
    "import:insights": "sanity exec scripts/import-static-insights.mjs --with-user-token",
    "migrate:immoworld-case-study": "sanity exec scripts/update-immoworld-case-study.mjs --with-user-token",
    "publish:immoworld-outcomes:dry-run": "sanity exec scripts/publish-immoworld-outcomes.mjs --with-user-token",
    "publish:immoworld-outcomes": "sanity exec scripts/publish-immoworld-outcomes.mjs --with-user-token -- --apply",
    "upsert:tarik-rami-case-study:dry-run": "sanity exec scripts/upsert-tarik-rami-case-study.mjs --with-user-token",
    "upsert:tarik-rami-case-study": "sanity exec scripts/upsert-tarik-rami-case-study.mjs --with-user-token -- --apply",
    "attach:tarik-rami-logo:dry-run": "sanity exec scripts/attach-tarik-rami-client-logo.mjs --with-user-token",
    "attach:tarik-rami-logo": "sanity exec scripts/attach-tarik-rami-client-logo.mjs --with-user-token -- --apply",
    "localization:baseline:dry-run": "sanity exec scripts/migrate-localization-baseline.mjs --with-user-token",
    "localization:baseline:apply": "sanity exec scripts/migrate-localization-baseline.mjs --with-user-token -- --apply",
    "localization:draft-baseline:dry-run": "sanity exec scripts/repair-localization-draft-baseline.mjs --with-user-token",
    "localization:draft-baseline:apply": "sanity exec scripts/repair-localization-draft-baseline.mjs --with-user-token -- --apply",
    "localization:french-drafts:dry-run": "sanity exec scripts/create-french-translation-drafts.mjs --with-user-token",
    "localization:french-drafts:apply": "sanity exec scripts/create-french-translation-drafts.mjs --with-user-token -- --apply",
    "localization:verify": "sanity exec scripts/verify-localization-state.mjs --with-user-token",
    "industries:migrate:dry-run": "sanity exec scripts/migrate-insight-industries.mjs --with-user-token",
    "industries:migrate": "sanity exec scripts/migrate-insight-industries.mjs --with-user-token -- --apply",
    "remove:unverified-case-study-metrics": "sanity exec scripts/remove-unverified-case-study-metrics.mjs --with-user-token",
    "upload:founder-portraits": "sanity exec scripts/upload-founder-portraits.mjs --with-user-token",
    "upload:insight-covers": "sanity exec scripts/upload-supplied-insight-covers.mjs --with-user-token",
    "upload:case-study-media:dry-run": "sanity exec scripts/upload-case-study-project-media.mjs --with-user-token",
    "upload:case-study-media": "sanity exec scripts/upload-case-study-project-media.mjs --with-user-token -- --apply",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/document-internationalization": "^6.2.24",
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^6.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.6.0",
    "sanity-plugin-internationalized-array": "^5.1.23",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "sharp": "^0.35.3",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
