#!/bin/sh
# Keep all pushes on dev. This does not verify Vercel's production branch setting.
while read local_ref local_sha remote_ref remote_sha
do
  if [ "$local_ref" != "refs/heads/dev" ] || [ "$remote_ref" != "refs/heads/dev" ]; then
    echo "Push blocked: this project only permits dev -> dev updates." >&2
    exit 1
  fi
done
exit 0
